# ============================================================
# Open BIM Information Platform — 本番環境変数サンプル
# このファイルは雛形です。本番では必ず強力な値に置き換え、
# .env（git管理外）として配置してください。
# ENVIRONMENT=production では、弱い値・既定値のままでは
# バックエンドが起動しません（production起動ガード）。
# ============================================================

# PostgreSQL
POSTGRES_DB=bim_platform
POSTGRES_USER=bim_user
POSTGRES_PASSWORD=change_me_openssl_rand_hex_16

# MinIO
MINIO_ROOT_USER=change_me_non_default_user
MINIO_ROOT_PASSWORD=change_me_openssl_rand_hex_16

# Backend / JWT署名
ENVIRONMENT=production
SECRET_KEY=change_me_openssl_rand_hex_32
CORS_ORIGINS=https://open-bim.example.com
# 自己登録は本番で禁止（管理者/OIDCによる利用者プロビジョニング必須）
ALLOW_SELF_REGISTRATION=false

# OIDC JITプロビジョニングを許可するメールドメイン（カンマ区切り・空なら全許可）
# OIDC_ALLOWED_DOMAINS=example.co.jp

# バックエンドワーカー数（Redis共有レート制限が有効な場合のみ2以上に増やす）
APP_WORKERS=2
# レート制限バックエンド（redis / memory）
RATE_LIMIT_BACKEND=redis
# bcryptコスト（既定12・10〜14の範囲で調整可。低すぎるとセキュリティ低下）
BCRYPT_ROUNDS=12

# Legacy object download temporary storage. New uploads use S3 SHA-256
# streaming and do not consume this quota. tmpfs must exceed the global limit.
DOWNLOAD_TEMP_REQUEST_LIMIT_BYTES=536870912
DOWNLOAD_TEMP_GLOBAL_LIMIT_BYTES=1073741824
DOWNLOAD_TEMP_TMPFS_SIZE=1100m

# frontend nginx非root UID/GID（certs/privkey.pemのownerに合わせる）
NGINX_RUNTIME_UID=1000
NGINX_RUNTIME_GID=1000

# バックアップ（scripts/backup.sh）
BACKUP_DIR=/var/backups/bim
BACKUP_ENCRYPTION_KEY=change_me_openssl_rand_hex_32
BACKUP_MAINTENANCE_CONFIRMED=false
POSTGRES_BACKUP_MODE=host
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PG_DUMP_BIN=/usr/lib/postgresql/16/bin/pg_dump
PSQL_BIN=/usr/lib/postgresql/16/bin/psql
MINIO_BACKUP_MODE=host

# 監視・通知（scripts/monitor.sh）
MONITOR_READY_URL=https://open-bim.example.com/ready
MONITOR_WEBHOOK_URL=
MONITOR_MAIL_TO=

# デプロイ（GitHub Actions / scripts/deploy.sh）
PROD_HOST=
PROD_USER=
PROD_SSH_PORT=22
