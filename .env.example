# Database
POSTGRES_DB=bim_platform
POSTGRES_USER=bim_user
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production

# Backend
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Rate limiting (in-process; single-worker deployments only)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=3
REGISTER_RATE_WINDOW_SECONDS=3600

# SMTP (outbound email notifications; optional, disabled by default)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
