[Unit]
Description=Open BIM Information Platform (Demo Mode)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/kensan/Projects/Open-BIM-Information-Platform
ExecStart=/usr/bin/docker compose -f docker-compose.demo.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.demo.yml down
TimeoutStartSec=180
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
